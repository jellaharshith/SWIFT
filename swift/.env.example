# SWIFT — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env.

# === Required ===
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# === Optional — Scanner ===
SWIFT_LOG_LEVEL=INFO
SWIFT_CONFIDENCE_THRESHOLD=0.95
SWIFT_SANDBOX_TIMEOUT=30
SWIFT_MAX_RETRIES=3

# === Kali Linux Container ===
KALI_IMAGE_TAG=swift-kali:latest
KALI_CONTAINER_TIMEOUT=300

# === Live CVE Feed ===
# NVD API key increases rate limit (50 req/30s vs 5 req/30s without key)
# Get free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
CVE_POLL_INTERVAL=2

# === v6.0 — OOB SSRF ===
# If set, OOB callbacks route through Interactsh instead of local listener
INTERACTSH_URL=

# === v6.0 — Audit Manifest Signing ===
# GPG key ID for engagement manifest signing; falls back to HMAC-SHA256 if unset
SWIFT_GPG_KEY_ID=

# === v6.0 — Audit Hash Chain Key ===
# Set to a secret string to enable HMAC-SHA256 keyed chain (forge-resistant).
# Without this, chain uses plain SHA-256 (detects corruption, not forgery).
SWIFT_AUDIT_HMAC_KEY=

# === v6.0 — Agentic Red-Team Budget ===
SWIFT_AGENT_BUDGET_PROBES=50
SWIFT_AGENT_BUDGET_SONNET=20
SWIFT_AGENT_BUDGET_SECONDS=3600

# === swiftsec_ai — LLM assistant (CVE RAG + tool-calling) ===
# Backend selector: auto | ollama | anthropic
#   auto = anthropic if ANTHROPIC_API_KEY is set, else ollama
SWIFTSEC_LLM_BACKEND=auto

# --- Ollama (local, no API key) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120

# --- Anthropic (REST, no SDK; reuses ANTHROPIC_API_KEY above) ---
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4096

# --- Local NVD/CVE mirror (RAG currency) ---
# NVD_API_KEY is defined above under "Live CVE Feed" — reused here.
SWIFTSEC_CVE_DB=swiftsec_cve.db
SWIFTSEC_CVE_INITIAL_DAYS=30
SWIFTSEC_CVE_MIN_SYNC_INTERVAL=7200
SWIFTSEC_CONTEXT_RESULTS=5
SWIFTSEC_MAX_TOOL_ITERS=6
