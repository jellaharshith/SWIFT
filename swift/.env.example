# SWIFT — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env.

# === Required ===
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# === Optional — Scanner ===
SWIFT_LOG_LEVEL=DEBUG
SWIFT_CONFIDENCE_THRESHOLD=0.95

# === Optional — Web Layer (Phase 2) ===
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
SWIFT_DB_PATH=./swift_scans.db

# === Optional — Email Notifications (Phase 2) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_app_password
FROM_EMAIL=swift-scanner@yourdomain.com

# === AWS Deployment ===
AWS_REGION=us-east-1

# === Netlify + Cloudflare Tunnel Deployment ===
NETLIFY_ORIGIN=https://swift-app.netlify.app
